# Database connection URLs
DATABASE_URL="postgres://{user}:{password}@{host}/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://{user}:{password}@{host}/neondb?sslmode=require"

# PostgreSQL connection details
PGDATABASE="neondb"
PGHOST="your-pooled-host"
PGHOST_UNPOOLED="your-unpooled-host"
PGPASSWORD="your-password"
PGUSER="your-user"

# Postgres specific configuration
POSTGRES_DATABASE="neondb"
POSTGRES_HOST="your-pooled-host"
POSTGRES_PASSWORD="your-password"
POSTGRES_USER="your-user"

# Additional connection URLs
POSTGRES_PRISMA_URL="postgres://{user}:{password}@{host}/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"
POSTGRES_URL="postgres://{user}:{password}@{host}/neondb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://{user}:{password}@{host}/neondb?sslmode=require"
POSTGRES_URL_NO_SSL="postgres://{user}:{password}@{host}/neondb"